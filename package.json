{
  "name": "agenthive",
  "version": "0.1.0",
  "description": "A local pixel-art hive to call, chat with and supervise your coding agents from the browser (built on the Claude Agent SDK; unofficial).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/servidor.ts",
    "demo": "node src/servidor.ts --demo",
    "check": "tsc",
    "test": "node --test test/"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-sdk",
    "agents",
    "dashboard",
    "pixel-art"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
